# Port the API server listens on
PORT=4000

# Optional: store the database and uploaded flyer photos outside this repo
# checkout (e.g. on a Raspberry Pi: /home/pi/familyhub-data/...). Not required -
# server/data/ and server/uploads/ are gitignored either way, so `git pull` on
# an EXISTING checkout never touches them. This matters if you ever re-clone
# the repo into a fresh folder (a new machine, a reinstall) and want your data
# to carry over automatically instead of starting empty.
# DB_PATH=/home/pi/familyhub-data/familyhub.sqlite3
# UPLOADS_DIR=/home/pi/familyhub-data/uploads

# Zip code used for the weather widget forecast
WEATHER_ZIP=05255
WEATHER_COUNTRY=us

# Household member labels shown across the app (defaults shown)
MEMBER_1_NAME=Mom
MEMBER_2_NAME=Dad
MEMBER_3_NAME=Child

# Google Calendar OAuth - two-way sync (create credentials at
# https://console.cloud.google.com/apis/credentials
# - Application type: Web application
# - Authorized redirect URI: http://<your-host>:4000/api/google/oauth2callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/oauth2callback

# Which Google calendar FamilyHub-created events get pushed to once
# connected above. Defaults to the signed-in account's own ("primary")
# calendar - only set this to sync to a shared family calendar instead (share
# it with the OAuth account as an editor first, then paste its Calendar ID
# from that calendar's Settings -> Integrate calendar).
# GOOGLE_CALENDAR_ID=primary

# Pre-fills the FIRST read-only shared calendar feed (Settings -> General,
# which supports adding more beyond this one). This is a calendar's "Secret
# address in iCal format" (that calendar's Settings -> Integrate calendar) -
# no Google sign-in needed, and separate from the OAuth connection above.
# Only used before anything's been saved from Settings; add/edit feeds there
# once you have more than one.
# ICAL_FEED_URL=https://calendar.google.com/calendar/ical/xxxx%40group.calendar.google.com/private-yyyy/basic.ics

# Used to sign the local session cookie
SESSION_SECRET=change-me-please

# Only needed if FamilyHub runs under a process supervisor (pm2, systemd, ...)
# instead of a bare `npm start` - the Settings -> Software Update button uses
# this to restart the app instead of killing/respawning the process itself,
# which would otherwise fight your supervisor's own restart policy.
# UPDATE_RESTART_CMD=pm2 restart familyhub

# Pre-fills the lunch menu sync URL (Settings -> Lunch, or set once here so a
# fresh install/new machine doesn't need it re-entered). Whatever's saved from
# Settings always wins over this once someone's used it there. The `date=`
# part doesn't matter and never needs updating - the sync always walks the
# current + next couple of months regardless of what date is in this URL.
# LUNCH_MENU_URL=https://menus.healthepro.com/organizations/<org-id>/sites/<site-id>/menus/<menu-id>

# Some school menu sites (Health-e Pro among them) load their menu entirely
# client-side, so syncing them requires rendering the page with a real
# browser rather than a plain HTTP fetch. FamilyHub looks for Chrome/Chromium
# in common install locations automatically (including the one you likely
# already installed for kiosk mode) - only set this if it can't find one:
# CHROMIUM_PATH=/usr/bin/chromium-browser
